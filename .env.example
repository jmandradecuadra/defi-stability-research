# ─────────────────────────────────────────────────────────────
# econ-analytics — API credentials template
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git. It is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── FRED (Federal Reserve Bank of St. Louis) ─────────────────
# Free key — register at: https://research.stlouisfed.org/docs/api/api_key.html
# Provides: VIX (VIXCLS), Fed Funds Rate (FEDFUNDS), DXY (DTWEXBGS)
FRED_API_KEY=6da8127ec1fb09638b3c2654ebd3a9a3

# ── Etherscan ─────────────────────────────────────────────────
# Free key — register at: https://etherscan.io → Client Portal → API Dashboard
# Provides: Ethereum gas fees (daily average)
# Rate limit: 5 calls/sec, 100,000 calls/day
ETHERSCAN_API_KEY=X3PF1C1HRFN57UWVYM4JYPVY283I8M9YS2

# ── Reddit / PRAW ─────────────────────────────────────────────
# EXCLUDED — Reddit API CAPTCHA loop prevented registration (2026-04-08).
# Reddit post volume removed from sentiment composite.
# Paper Section 4.1 notes three-source composite:
#   Fear & Greed Index + Google Trends + LunarCrush.

# ── LunarCrush ────────────────────────────────────────────────
# Free Discover plan — register at: https://lunarcrush.com/developers
# Provides: Bitcoin/ETH social volume and sentiment score
# Note: free tier has rate limits — copy token immediately after generation
LUNARCRUSH_TOKEN=ikccrpbxu7h92u3gj326swl5aimnq2rshjza7ohmd

# ── No key required (these are called directly in code) ───────
# Alternative.me Fear & Greed:  https://api.alternative.me/fng/?limit=0&format=json
# DeFiLlama TVL:                https://api.llama.fi/
# Binance OHLCV:                https://api.binance.com/api/v3/klines (public)
# CoinGecko prices:             https://api.coingecko.com/api/v3 (public, rate-limited)
# Google Trends:                via pytrends (no key, uses session cookies)
